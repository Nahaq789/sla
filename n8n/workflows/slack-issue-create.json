      "parameters": {
        "jsCode": "// Slack の署名を確かめる\nconst crypto = require('crypto');\n\nconst item = $input.first();\nconst headers = item.json.headers;\nconst timestamp = headers['x-slack-request-timestamp'];\nconst signature = headers['x-slack-signature'] ?? '';\n\n// 5 分以上ずれたリクエストは拒否する (昔のリクエストをコピーして送り直す攻撃への対策)\nif (!timestamp || Math.abs(Date.now() / 1000 - Number(timestamp)) > 60 * 5) {\n  throw new Error('Slack のリクエストの時刻が不正です');\n}\n\n// 署名は、Slack が送ってきたままの本文で計算する\nconst rawBody = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\nconst expected = 'v0=' + crypto\n  .createHmac('sha256', $env.SLACK_SIGNING_SECRET)\n  .update(`v0:${timestamp}:${rawBody}`)\n  .digest('hex');\n\nif (signature.length !== expected.length ||\n    !crypto.timingSafeEqual(Buffer.from(signature), Buffer.from(expected))) {\n  throw new Error('Slack の署名が一致しません');\n}\n\n// ボタンの値と、後で使う情報を取り出す\nconst payload = JSON.parse(item.json.body.payload);\nconst { thread_ts, draft_id } = JSON.parse(payload.actions[0].value);\n\nreturn [{\n  json: {\n    thread_ts,\n    draft_id,\n    channel: payload.channel.id,\n    message_ts: payload.message.ts,     // ボタンが付いたメッセージ (後でボタンを消すのに使う)\n    user: payload.user.id,\n  },\n}];"
      },
