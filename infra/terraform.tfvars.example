# このファイルをコピーして terraform.tfvars を作成してください
# terraform.tfvars は .gitignore により追跡対象外です

# Bedrock 推論プロファイル ID
# 日本国内で処理するため jp. の Claude Sonnet 4.6 を使う
# (us. のプロファイルは東京リージョンからは呼び出せない)
bedrock_model_id = "jp.anthropic.claude-sonnet-4-6"

# Langfuse Cloud のホスト URL
# データを国内に置くため日本リージョンを使う（サインアップ時に日本リージョンを選択する）
langfuse_host = "https://jp.cloud.langfuse.com"

# 予算アラートの通知先メールアドレス
alert_email = "your-email@example.com"

# 月次予算上限（USD）。デフォルト: 10（約 1,500 円相当）
monthly_budget_usd = 10
